// Esquema Prisma do aplicativo Glicemia.
// Modela usuários, sessões e medições de glicemia no Neon PostgreSQL.
// As datas são persistidas como timestamptz (instante UTC).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Usuário autenticado da aplicação.
model User {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  sessions     Session[]
  readings     GlucoseReading[]

  @@index([email])
}

/// Sessão persistida no banco. Apenas o hash do token é armazenado.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Registro de tentativas de autenticação para limitação de taxa.
model AuthAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  success    Boolean
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([identifier, createdAt])
}

/// Contexto em que a medição de glicemia foi realizada.
enum GlucoseContext {
  jejum
  antes_refeicao
  depois_refeicao
  ao_deitar
  outro
}

/// Registro de uma medição de glicemia realizada com glicosímetro de ponta de dedo.
model GlucoseReading {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  measuredAt  DateTime        @db.Timestamptz(3)
  glucoseMgDl Int
  context     GlucoseContext
  notes       String?         @db.VarChar(1000)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt(sort: Desc)])
}